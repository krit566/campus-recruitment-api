# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# signs login tokens; at least 32 random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-at-least-32-random-characters
# first placement-officer login, created on start if no officer exists (password: 12+ characters)
RECRUIT_OFFICER_EMAIL=officer@geu.ac.in
RECRUIT_OFFICER_PASSWORD=change-me-officer-password
# optional: an API key for scripts (X-API-Key header); leave empty to disable
RECRUIT_ADMIN_KEY=
COLLEGE_EMAIL_DOMAIN=geu.ac.in
# 1 shows the fictional demo logins on the sign-in page (only with seeded demo data)
VITE_DEMO=0
